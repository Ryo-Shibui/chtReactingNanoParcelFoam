FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/fluid/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          100;
        startFace       3880;
    }
    outlet
    {
        type            patch;
        nFaces          100;
        startFace       3980;
    }
    lowerElectrode
    {
        type            wall;
        inGroups        1(wall);
        nFaces          20;
        startFace       4080;
    }
    upperElectrode
    {
        type            wall;
        inGroups        1(wall);
        nFaces          20;
        startFace       4100;
    }
    front
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          2000;
        startFace       4120;
    }
    back
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          2000;
        startFace       6120;
    }
)

