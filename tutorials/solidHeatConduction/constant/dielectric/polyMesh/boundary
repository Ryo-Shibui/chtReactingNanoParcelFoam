FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/dielectric/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          5;
        startFace       175;
    }
    outlet
    {
        type            patch;
        nFaces          5;
        startFace       180;
    }
    lowerElectrode
    {
        type            wall;
        inGroups        1(wall);
        nFaces          20;
        startFace       185;
    }
    dielectric_to_fluid
    {
        type            mappedWall;
        inGroups        2(wall mappedPatch);
        nFaces          20;
        startFace       205;
        sampleMode      nearestPatchFace;
        sampleRegion    fluid;
        samplePatch     fluid_to_dielectric;
    }
    front
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          100;
        startFace       225;
    }
    back
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          100;
        startFace       325;
    }
)

