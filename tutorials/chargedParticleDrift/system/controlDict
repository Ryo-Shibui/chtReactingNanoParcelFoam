FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application             chtReactingNanoParcelFoam;
startFrom               startTime;
startTime               0;
stopAt                  endTime;
endTime                 0.0005;
deltaT                  1e-6;
writeControl            timeStep;
writeInterval           100;
purgeWrite              0;
writeFormat             ascii;
writePrecision          12;
writeCompression        off;
timeFormat              general;
timePrecision           10;
runTimeModifiable       false;
adjustTimeStep          no;
maxCo                   0.5;
maxDi                   10;

